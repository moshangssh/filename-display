// ✅ 正确的 CodeMirror 6 状态管理和事务处理
import { EditorState, StateField, Transaction } from '@codemirror/state';
import { EditorView, Decoration } from '@codemirror/view';

// 1. 定义状态字段
const myStateField = StateField.define<MyState>({
  // 创建初始状态
  create: () => initialValue,
  
  // 状态更新函数（reducer）
  update: (value, tr) => {
    // 检查是否需要更新此状态
    if (tr.docChanged || someOtherCondition) {
      // 基于事务内容计算新状态
      return newValue;
    }
    return value;
  },
  
  // 提供视图服务（可选）
  provide: field => EditorView.decorations.from(field, value => {
    // 返回基于状态的装饰
    return Decoration.set([]);
  })
});

// 2. 创建编辑器实例
const view = new EditorView({
  state: EditorState.create({
    doc: "初始文档内容",
    extensions: [
      // 添加状态字段
      myStateField,
      // 其他扩展...
    ]
  }),
  parent: document.body
});

// 3. 通过事务更新编辑器
function updateEditor(text: string, from: number, to: number) {
  // 创建并分发事务
  view.dispatch({
    changes: { from, to, insert: text },
    // 可选：更新选区
    selection: { anchor: from + text.length },
    // 可选：添加事务效果
    effects: [someEffect.of(value)],
    // 可选：滚动到视图
    scrollIntoView: true
  });
}

// 4. 基于选区创建事务
function formatSelection() {
  const { state } = view;
  // 使用 changeByRange 处理多选区
  const changes = state.changeByRange(range => {
    const text = state.doc.sliceString(range.from, range.to);
    const formatted = formatText(text);
    
    return {
      changes: { from: range.from, to: range.to, insert: formatted },
      range: EditorSelection.range(range.from, range.from + formatted.length)
    };
  });
  
  view.dispatch(changes);
}
</example>

