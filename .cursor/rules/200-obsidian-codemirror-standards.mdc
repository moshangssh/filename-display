        if (update.docChanged) {
          // 文档变化时的处理
        }
      })
    ]);
    
    // 处理编辑器命令
    this.addCommand({
      id: 'format-selection',
      name: '格式化选中文本',
      editorCallback: (editor, view) => {
        // 获取 CodeMirror 编辑器实例
        const cmEditor = this.getCodeMirrorInstance(editor, view);
        if (cmEditor) {
          // 执行 CodeMirror 操作
          formatSelection(cmEditor);
        }
      }
    });
  }
  
  // 获取 CodeMirror 编辑器实例的辅助方法
  getCodeMirrorInstance(editor, view) {
    // 根据 Obsidian API 获取 CodeMirror 实例
    // 注意：具体实现方式可能因 Obsidian 版本而异
  }
}
