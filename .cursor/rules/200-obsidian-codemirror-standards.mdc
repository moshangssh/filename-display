// ✅ 正确的 Obsidian 核心 API 使用方式
import { App, TFile, TFolder, Plugin, MarkdownView } from 'obsidian';

export default class CoreApiPlugin extends Plugin {
  async onload() {
    // 1. Vault API - 文件操作
    // 读取文件内容 (只读场景)
    this.addCommand({
      id: 'read-file',
      name: '读取文件内容',
      callback: async () => {
        // 获取当前活动文件
        const activeFile = this.app.workspace.getActiveFile();
        if (activeFile instanceof TFile) {
          // 只读场景: 使用 cachedRead 避免多次从磁盘读取
          const content = await this.app.vault.cachedRead(activeFile);
          new Notice(`文件内容: ${content.substring(0, 50)}...`);
        }
      }
    });

    // 修改文件内容 (读写场景)
    this.addCommand({
      id: 'modify-file',
      name: '修改文件内容',
      callback: async () => {
        const activeFile = this.app.workspace.getActiveFile();
        if (activeFile instanceof TFile) {
          // 读写场景: 使用 read 获取最新内容，避免覆盖其他更改
          const content = await this.app.vault.read(activeFile);
          // 使用 modify 更新文件内容
          await this.app.vault.modify(activeFile, content + '\n新增内容');
        }
      }
    });

    // 2. App API - 元数据缓存
    this.addCommand({
      id: 'get-frontmatter',
      name: '获取文件前置元数据',
      callback: () => {
        const activeFile = this.app.workspace.getActiveFile();
        if (activeFile) {
          // 获取文件元数据
          const fileCache = this.app.metadataCache.getFileCache(activeFile);
          const frontmatter = fileCache?.frontmatter;
          if (frontmatter) {
            new Notice(`前置元数据: ${JSON.stringify(frontmatter)}`);
          }
        }
      }
    });

    // 3. Workspace API - 编辑器操作
    this.addCommand({
      id: 'insert-text',
      name: '在当前位置插入文本',
      editorCallback: (editor: Editor) => {
        // 获取光标位置
        const cursor = editor.getCursor();
        // 在光标位置插入文本
        editor.replaceRange('插入的文本', cursor);
      }
    });

    // 4. 文件存在性检查 (安全操作)
    this.addCommand({
      id: 'check-file',
      name: '检查文件是否存在',
      callback: async () => {
        const filePath = 'test.md';
        // 安全地检查文件是否存在
        const exists = await this.app.vault.adapter.exists(filePath);
        new Notice(`文件 ${filePath} ${exists ? '存在' : '不存在'}`);
      }
    });

    // 5. 处理特殊文件 (以点开头的文件)
    this.addCommand({
      id: 'read-config',
      name: '读取配置文件',
      callback: async () => {
        try {
          // 使用 adapter API 读取特殊文件
          const content = await this.app.vault.adapter.read('.config');
          new Notice(`配置内容: ${content}`);
        } catch (error) {
          new Notice('配置文件不存在');
        }
      }
    });
  }
}
</example>

