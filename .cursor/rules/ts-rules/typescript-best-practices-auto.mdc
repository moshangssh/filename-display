      .catch(err => console.error(err));
      
    fetch('/api/posts')
      .then(res => res.json())
      .then(data => { setPosts(data); setLoading2(false); })
      .catch(err => console.error(err));
      
    fetch('/api/comments')
      .then(res => res.json())
      .then(data => { setComments(data); setLoading3(false); })
      .catch(err => console.error(err));
  }, []);
  
  // 过多的内联JSX逻辑，未拆分组件
