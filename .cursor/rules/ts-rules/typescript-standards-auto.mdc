# TypeScript Development Standards

## Context

- Applies to all TypeScript project development
- Ensures code quality, maintainability, and type safety
- Helps team members follow consistent coding style

## Critical Rules

- Always explicitly declare types for variables and parameters, avoid excessive use of `any` type
- Use interfaces to define object structures, use type aliases for union and intersection types
- Add return type annotations to functions to improve code readability and type safety
- Prefer type inference over explicit type annotations, but specify types when needed
- Use optional chaining (`?.`) and nullish coalescing operator (`??`) to handle potentially null values
- Set access modifiers (`public`, `private`, `protected`) for class properties
- Use enums to represent a set of related constants
- Leverage generics to create reusable components and functions
- Avoid type assertions unless absolutely necessary
- Use `readonly` modifier to protect properties that shouldn't be modified
- Adopt strict compilation options like `strictNullChecks`
- Use modular design, avoid global variable pollution
- Follow single responsibility principle, each class or function should handle one functionality

## Examples

<example>
// Good TypeScript practices
interface User {
  id: number;
  name: string;
  email: string;
  age?: number;
}

function fetchUserData(userId: number): Promise<User> {
  return fetch(`/api/users/${userId}`)
    .then(response => {
      if (!response.ok) {
        throw new Error('Network request failed');
      }
      return response.json() as Promise<User>;
    });
}

class UserManager {
  private users: Map<number, User> = new Map();
  
  public async addUser(userId: number): Promise<void> {
    const userData = await fetchUserData(userId);
    this.users.set(userData.id, userData);
  }
  
  public getUser(userId: number): User | undefined {
    return this.users.get(userId);
  }
}

// Using generics to create reusable components
function createState<T>(initialState: T): [() => T, (newState: T) => void] {
  let state = initialState;
  return [
    () => state,
    (newState: T) => { state = newState; }
  ];
}
</example>

<example type="invalid">
// Poor TypeScript practices
function processData(data) {  // Missing type annotations
  var result = [];  // Using var instead of let/const, and missing type
  
  for (var i = 0; i < data.length; i++) {
    if (data[i].isValid) {  // Structure of data elements not defined
      result.push(data[i].value);
    }
  }
  
  return result;  // Missing return type annotation
}

// Misuse of any type
let userInfo: any = {
  name: "John",
  age: 30
};
userInfo.address = "New York";  // No type checking
userInfo(123);  // Runtime error, not detected during compilation

// Excessive use of type assertions
const element = document.getElementById('app') as HTMLDivElement;  // Should use type guard
let value: any = "123";
let numValue = value as number;  // Unsafe type conversion

// Global variable pollution
const globalUsers = [];  // Global variable, missing type
function addGlobalUser(user) {  // Missing type annotation
  globalUsers.push(user);
}
</example> 